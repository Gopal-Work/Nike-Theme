# =========================================================================
# WordPress .gitignore Template
# =========================================================================

# -------------------------------------------------------------------------
# Core Files
# Ignore WordPress core files. You usually manage these via WP-CLI, Bedrock, 
# or standard deployment tools rather than tracking them in Git.
# -------------------------------------------------------------------------
/*
!.gitignore
!wp-content/

# -------------------------------------------------------------------------
# WordPress Content Directory
# Ignore core uploads and system-generated content.
# -------------------------------------------------------------------------
wp-content/uploads/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/backup-db/
wp-content/backups/
wp-content/cache/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php

# -------------------------------------------------------------------------
# Config and Environment Files
# NEVER commit database credentials, API keys, or environment configuration.
# -------------------------------------------------------------------------
wp-config.php
wp-config-local.php
.env
.env.*
!.env.example

# -------------------------------------------------------------------------
# Plugins & Themes Rules
# Choose your workflow approach below (Default: track custom, ignore 3rd party).
# -------------------------------------------------------------------------

# Option A (Recommended): Ignore third-party plugins/themes, track custom ones.
# Step 1: Ignore everything in plugins and themes
wp-content/plugins/*
wp-content/themes/*

# Step 2: Un-ignore your custom plugins and themes here
!wp-content/plugins/my-custom-plugin/
!wp-content/themes/my-custom-theme/

# (Alternative Option B): Track ALL plugins and themes except core defaults.
# To use Option B, comment out Option A above and uncomment the lines below:
# wp-content/themes/twenty*

# -------------------------------------------------------------------------
# Web Server & System Files
# -------------------------------------------------------------------------
.htaccess
web.config
sitemap.xml
sitemap.xml.gz
robots.txt

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor & IDE Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Logs & Databases
*.log
*.sql
*.sqlite

# Node & Build Tooling (if building custom themes/plugins with NPM/Composer)
node_modules/
vendor/
npm-debug.log
yarn-error.log
.sass-cache/
.dist/