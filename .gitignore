# =========================================================================
# WordPress .gitignore Template (Configured for Nike-Theme)
# =========================================================================

# -------------------------------------------------------------------------
# Core Files
# Ignore WordPress core files in the root directory.
# -------------------------------------------------------------------------
/*
!.gitignore
!wp-content/

# -------------------------------------------------------------------------
# WordPress Content Directory
# Ignore core uploads and system-generated content.
# -------------------------------------------------------------------------
wp-content/uploads/
wp-content/blogs.dir/
wp-content/upgrade/
wp-content/backup-db/
wp-content/backups/
wp-content/cache/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php

# -------------------------------------------------------------------------
# Config and Environment Files
# NEVER commit database credentials, API keys, or environment configuration.
# -------------------------------------------------------------------------
wp-config.php
wp-config-local.php
.env
.env.*
!.env.example

# -------------------------------------------------------------------------
# Plugins & Themes
# Ignore all third-party plugins and themes except your Nike-Theme.
# -------------------------------------------------------------------------
wp-content/plugins/*
wp-content/themes/*

# EXCEPTION: Un-ignore your custom theme folder
!wp-content/themes/Nike-Theme/

# -------------------------------------------------------------------------
# Server, System & Editor Files
# -------------------------------------------------------------------------
.htaccess
web.config
sitemap.xml
sitemap.xml.gz
robots.txt

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor & IDE Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Logs & Databases
*.log
*.sql
*.sqlite

# Build Tooling (if using NPM/Composer inside your theme)
node_modules/
vendor/
npm-debug.log
yarn-error.log
.sass-cache/
.dist/